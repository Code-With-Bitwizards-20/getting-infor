{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path__=/api/status"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path__=/api/$1"
    }
  ]
}
