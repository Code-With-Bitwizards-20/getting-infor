{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/style\\.css",
      "dest": "/api/index.py"
    },
    {
      "src": "/app\\.js",
      "dest": "/api/index.py"
    },
    {
      "src": "/favicon\\.svg",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
